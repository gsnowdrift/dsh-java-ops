{
  "name": "@gsnowdrift/dsh-java-ops",
  "version": "0.2.1-rc.1",
  "type": "module",
  "description": "赋予 AI 编译、启停、重启 Java / Spring Boot 服务的能力，并让它自己发 HTTP 请求测接口、用 SQL 读数据验结果——改代码到验证的闭环都在会话里完成。",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "mysql2": "^3.24.6",
    "undici": "^8.12.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsnowdrift/dsh-java-ops.git"
  },
  "homepage": "https://github.com/gsnowdrift/dsh-java-ops",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "spring-boot",
    "java",
    "sql"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs"
  }
}
